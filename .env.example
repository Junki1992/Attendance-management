# ===========================================
# 勤怠管理システム - 環境変数テンプレート
# ===========================================
# このファイルを .env.local にコピーし、値を設定してください。
# 機密情報は .env.local に直接記載し、Git にコミットしないでください。

# --- Firebase（必須）---
# Firebase コンソール → プロジェクトの設定 → 全般 → マイアプリ で取得
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- 最初の管理者（推奨）---
# このメールアドレスで新規登録した場合のみ、管理者として作成されます
# 一度作成したら削除可能
# NEXT_PUBLIC_FIRST_ADMIN_EMAIL=admin@example.com

# --- チャット機能（オプション）---
# スタッフが管理者にメッセージを送るために必要
# Firebase コンソール → Authentication → ユーザー で管理者の UID を確認
# NEXT_PUBLIC_ADMIN_UID=

# --- 開発用（本番では設定しない）---
# パスワードなしでログインできるボタンを表示（セキュリティ上、本番では無効）
# NEXT_PUBLIC_ENABLE_MOCK_LOGIN=1

# --- デバッグ（オプション）---
# Firestore の接続に問題がある場合に Long Polling を強制
# NEXT_PUBLIC_FIREBASE_FORCE_LONG_POLLING=1
