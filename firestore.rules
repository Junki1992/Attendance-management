rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // users コレクション：role の書き換えを禁止して管理者アクセスを保護
    match /users/{userId} {
      // 作成：新規登録時のみ。role は "staff" または "admin" を許可
      // 最初の管理者は環境変数 NEXT_PUBLIC_FIRST_ADMIN_EMAIL で指定されたメールアドレスで登録した場合のみ作成可能
      allow create: if request.auth != null 
                    && request.auth.uid == userId 
                    && (request.resource.data.role == "staff" || request.resource.data.role == "admin");
      
      // 読み取り：
      // - 自分のドキュメントは全フィールド読める
      // - 管理者は他のユーザーのドキュメントも読める（getAllStaff などで必要）
      // - 認証済みなら role=="admin" のドキュメントは誰でも読める（スタッフの getAdminId クエリを通すため）
      // - 上記がないと「where role==admin」クエリがスタッフで permission-denied になる
      allow read: if request.auth != null 
                  && (request.auth.uid == userId 
                      || resource.data.role == "admin"
                      || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
      
      // 更新：
      // - 自分のドキュメント：name, email, hourlyWage のみ更新可（role は変更不可）
      // - 管理者は他のユーザーの role も変更可能（管理者昇格・降格）
      allow update: if request.auth != null 
                    && ((request.auth.uid == userId 
                         && request.resource.data.role == resource.data.role)
                        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
      
      // 削除：自分のドキュメント、または管理者が他ユーザーを削除可能
      allow delete: if request.auth != null 
                    && (request.auth.uid == userId 
                        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
      
      // 時給変更履歴サブコレクション（管理者のみ読める・管理者のみ追記可・管理者のみ削除可）
      match /wageHistory/{logId} {
        allow read: if request.auth != null && isAdmin();
        allow create: if request.auth != null && isAdmin();
        allow update: if false;
        allow delete: if request.auth != null && isAdmin();
      }
    }
    
    // shifts コレクション（既存のルールがあれば追加）
    match /shifts/{shiftId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    
    // messages コレクション（送信者 or 受信者のみ読める）
    match /messages/{messageId} {
      // 読み取り：送信者または受信者のみ読める
      // Firestoreのセキュリティルールでは、クエリが返す可能性のあるすべてのドキュメントがルールを満たす必要がある
      // クエリで where("senderId", "==", request.auth.uid) を使用している場合、
      // 返されるすべてのドキュメントは senderId == request.auth.uid を満たすため、
      // resource.data.senderId == request.auth.uid を満たす
      // 同様に、where("receiverId", "==", request.auth.uid) を使用している場合、
      // 返されるすべてのドキュメントは receiverId == request.auth.uid を満たすため、
      // resource.data.receiverId == request.auth.uid を満たす
      // したがって、クエリが返すすべてのドキュメントはこのルールを満たす
      // 読み取り：
      // - 送信者/受信者は読める
      // - 管理者(role=admin)は全メッセージを読める（UIDズレ等で宛先がズレたデータも調査/復旧できるように）
      allow read: if request.auth != null
                  && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      // 作成：送信者が認証ユーザーである必要がある
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      // 更新：送信者または受信者のみ
      allow update: if request.auth != null
                    && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      // 削除：送信者または受信者のみ
      allow delete: if request.auth != null
                    && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
    }
    
    // chatRooms コレクション：ルームメタ（lastReadBy）を保持
    match /chatRooms/{roomId} {
      // 読み取り：まずは認証ユーザーであれば読み取りを許可（即時復旧のため）。
      // 将来的には participants ベースの制限に戻すことを検討してください。
      allow read: if request.auth != null;

      // 作成：認証ユーザーなら可（必要なら participants のチェックを追加）
      allow create: if request.auth != null;

      // 更新：認証ユーザーは自分の lastReadBy を書き込める。
      // serverTimestamp() はルール評価時に timestamp 型と判定されないことがあるため、
      // 自 UID のキーが存在することをのみ検証する。
      allow update: if request.auth != null
                    && request.resource.data.lastReadBy != null
                    && request.resource.data.lastReadBy[request.auth.uid] != null;

      // 削除：管理者のみ
      allow delete: if isAdmin();
    }

    // notifications: 本人 or 管理者が read/delete 可（管理者はユーザー削除時に他ユーザー分を取得して削除する）
    match /notifications/{notificationId} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // settings コレクション
    match /settings/{settingId} {
      // app は全員読める（締切日など）。chatwork は管理者のみ（API トークン含む）
      allow read: if request.auth != null 
                  && (settingId != "chatwork" || isAdmin());
      allow create, update, delete: if request.auth != null && isAdmin();
    }
    
    // presence: オンライン状態（lastActiveAt）。スタッフがハートビートで更新、管理者がチャット一覧で参照
    match /presence/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // shiftChangeRequests コレクション
    match /shiftChangeRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // シフト提出時のコメント（1ユーザー・1月1件）
    match /shiftSubmitComments/{docId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // 退職者シフト（退職・削除済みスタッフ）のデータ（管理者のみ読み書き）
    match /shiftArchives/{docId} {
      allow read, write: if isAdmin();
    }
    match /shiftArchiveUsers/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
